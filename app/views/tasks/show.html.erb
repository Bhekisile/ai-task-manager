<h1><%= @task.title %></h1>

<hr>

<p>
  <strong>Description:</strong><br>
  <%= @task.description.presence || "No description provided." %>
</p>

<p>
  <strong>Due Date:</strong><br>
  <%= @task.due_date %>
</p>

<p>
  <strong>Estimated minutes:</strong><br>
  <%= @task.estimated_minutes %>
</p>

<p>
  <strong>Priority:</strong>
  <%= @task.priority.humanize %>
</p>

<p>
  <strong>Status:</strong>
  <%= @task.status.humanize %>
</p>

<br>

<% unless @task.done? %>

  <%= button_to "Mark as completed",
                complete_project_task_path(@project, @task),
                method: :patch %>
<% else %>
  ✓ Completed
<% end %>

<hr>

<%= button_to "Delete Task",
              [@project, @task],
              method: :delete,
              data: { turbo_confirm: "Are you sure?" } %>


